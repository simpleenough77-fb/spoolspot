#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# Runs before every commit: secret scan of staged changes, formatting, lint, types.
set -eu
root="$(git rev-parse --show-toplevel)"
cd "$root"

gitleaks_bin=""
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks_bin="$(command -v gitleaks)"
elif [ -x "$root/.tools/bin/gitleaks" ]; then
  gitleaks_bin="$root/.tools/bin/gitleaks"
fi
if [ -z "$gitleaks_bin" ]; then
  echo "pre-commit: gitleaks not found. Run: sh scripts/install-gitleaks.sh" >&2
  exit 1
fi

"$gitleaks_bin" git --pre-commit --staged --redact --no-banner

pnpm exec prettier --check --ignore-unknown $(git diff --cached --name-only --diff-filter=ACM)
pnpm lint
pnpm typecheck
