{
  "name": "spoolspot",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, location-first filament inventory.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.8.1"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "hooks:install": "sh scripts/install-hooks.sh",
    "check:spdx": "node scripts/check-spdx.ts",
    "seed:validate": "node scripts/validate-seed.ts && node scripts/validate-catalog.ts",
    "check:actions-pinned": "node scripts/check-actions-pinned.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "a11y": "node scripts/a11y-check.ts",
    "audit:deps": "pnpm audit --audit-level high",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm seed:validate && pnpm check:actions-pinned && pnpm check:spdx",
    "dev": "node app/src/server.ts",
    "db:migrate": "node scripts/migrate.ts",
    "seed:import": "node scripts/import-seed.ts",
    "demo:fill": "node scripts/demo-data.ts fill",
    "demo:remove": "node scripts/demo-data.ts remove",
    "demo:links": "node scripts/demo-links.ts",
    "catalog:import": "node scripts/catalog-import.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
