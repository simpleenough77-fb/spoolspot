{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpoolSpot event",
  "description": "One entry of the append-only movement history (ADR-0006). Types, ids and a server timestamp only: no free text. The tenant is implied by the caller and is never part of the document. Licensed CC0-1.0 (see REUSE.toml).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "clip_id",
    "filament_id",
    "from_location_id",
    "to_location_id",
    "occurred_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": {
      "enum": ["intake", "open", "move", "load", "unload", "empty", "retire", "refill"]
    },
    "clip_id": { "type": ["string", "null"], "format": "uuid" },
    "filament_id": { "type": ["string", "null"], "format": "uuid" },
    "from_location_id": {
      "type": ["string", "null"],
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "to_location_id": {
      "type": ["string", "null"],
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "occurred_at": {
      "description": "Server time of the change, UTC.",
      "type": "string",
      "format": "date-time"
    }
  }
}
