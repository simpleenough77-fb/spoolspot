{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpoolSpot filament catalog (sample format)",
  "description": "A filament catalog a SpoolSpot instance can import. This is a SAMPLE format until the Filament Clip Studio contract (SPOOL-7) defines catalog.json; no change to the studio is assumed. Structural rules only; duplicate ids and duplicate manufacturer/type/color are checked by app/src/catalog/validate.ts. Licensed CC0-1.0 (see REUSE.toml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated", "filaments"],
  "properties": {
    "version": {
      "description": "Version of the catalog format, MAJOR.MINOR.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "generated": {
      "description": "Date the file was generated (YYYY-MM-DD).",
      "type": "string",
      "format": "date"
    },
    "filaments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/filament" }
    }
  },
  "$defs": {
    "text": {
      "description": "No control characters, no leading or trailing space.",
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u0085\\u2028\\u2029 ](?:[^\\u0000-\\u001f\\u007f\\u0085\\u2028\\u2029]*[^\\u0000-\\u001f\\u007f\\u0085\\u2028\\u2029 ])?$"
    },
    "filament": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manufacturer", "type", "color", "spool_kind"],
      "properties": {
        "id": {
          "description": "Stable filament id (lowercase UUID). The same filament keeps the same id in every catalog version.",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "manufacturer": {
          "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 80 }]
        },
        "type": { "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 40 }] },
        "color": { "allOf": [{ "$ref": "#/$defs/text" }, { "type": "string", "maxLength": 80 }] },
        "spool_kind": { "enum": ["refillable", "disposable"] }
      }
    }
  }
}
